<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome to OptionLensa — Thank You!</title>
<meta name="robots" content="noindex">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&family=Exo+2:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --black:   #050810;
  --dark:    #080d1a;
  --dark2:   #0d1528;
  --border:  rgba(0,180,255,0.15);
  --blue:    #00b4ff;
  --cyan:    #00e5ff;
  --green:   #00e676;
  --txt0:    #ffffff;
  --txt1:    #d0e4f0;
  --txt2:    #8aaccc;
  --txt3:    #4a6a8a;
  --grad1:   linear-gradient(135deg, #00b4ff 0%, #7c3aed 50%, #00e676 100%);
  --font-head:   'Exo 2', sans-serif;
  --font-accent: 'Rajdhani', sans-serif;
  --font-mono:   'JetBrains Mono', monospace;
}
* { margin:0; padding:0; box-sizing:border-box; }
html, body {
  height: 100%;
  background: var(--black);
  color: var(--txt1);
  font-family: var(--font-head);
  overflow: hidden;
}

/* Background effects */
.bg {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 60% at 50% 40%, rgba(0,180,255,0.1) 0%, transparent 70%),
    radial-gradient(ellipse 40% 40% at 80% 70%, rgba(124,58,237,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 40% 40% at 20% 30%, rgba(0,230,118,0.06) 0%, transparent 60%),
    var(--black);
}
.grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,180,255,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,180,255,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
}

/* Particles */
.particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}
.particle {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--green);
  animation: floatUp linear infinite;
  opacity: 0;
}
@keyframes floatUp {
  0%   { opacity: 0; transform: translateY(0) scale(0); }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { opacity: 0; transform: translateY(-100vh) scale(1); }
}

/* Main content */
.container {
  position: relative;
  z-index: 10;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  text-align: center;
}

/* Logo */
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 40px;
  animation: fadeDown .6s ease both;
}
.logo img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  box-shadow: 0 0 20px rgba(0,180,255,0.4);
}
.logo-text {
  font-family: var(--font-accent);
  font-size: 26px;
  font-weight: 700;
  letter-spacing: .12em;
  background: var(--grad1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Checkmark */
.check-wrap {
  position: relative;
  width: 100px;
  height: 100px;
  margin: 0 auto 32px;
  animation: fadeUp .6s .1s ease both;
}
.check-circle {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 3px solid var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  background: rgba(0,230,118,0.08);
  box-shadow: 0 0 40px rgba(0,230,118,0.25), 0 0 80px rgba(0,230,118,0.1);
  animation: popIn .5s .3s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes popIn {
  from { transform: scale(0); opacity: 0; }
  to   { transform: scale(1); opacity: 1; }
}

/* Text */
.thank-label {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--green);
  letter-spacing: .2em;
  text-transform: uppercase;
  margin-bottom: 12px;
  animation: fadeUp .6s .4s ease both;
}
.thank-title {
  font-family: var(--font-head);
  font-size: clamp(28px, 5vw, 52px);
  font-weight: 900;
  color: var(--txt0);
  line-height: 1.1;
  margin-bottom: 16px;
  animation: fadeUp .6s .5s ease both;
}
.thank-title span {
  background: var(--grad1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.thank-sub {
  font-size: clamp(14px, 2vw, 17px);
  color: var(--txt2);
  max-width: 480px;
  line-height: 1.7;
  margin: 0 auto 40px;
  animation: fadeUp .6s .6s ease both;
}

/* Steps */
.steps {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 48px;
  animation: fadeUp .6s .7s ease both;
}
.step {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(0,180,255,0.06);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 18px;
  font-size: 13px;
  color: var(--txt1);
}
.step-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), #7c3aed);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

/* Buttons */
.btn-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  animation: fadeUp .6s .8s ease both;
}
.btn-whop {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--blue), #7c3aed);
  color: white;
  text-decoration: none;
  padding: 14px 36px;
  border-radius: 10px;
  font-family: var(--font-accent);
  font-size: 17px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  transition: all .25s;
  box-shadow: 0 0 30px rgba(0,180,255,0.35);
}
.btn-whop:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 50px rgba(0,180,255,0.55);
}
.btn-home {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--txt2);
  text-decoration: none;
  font-family: var(--font-accent);
  font-size: 15px;
  font-weight: 600;
  letter-spacing: .05em;
  padding: 8px 16px;
  border-radius: 8px;
  border: 1px solid transparent;
  transition: all .2s;
}
.btn-home:hover {
  color: var(--blue);
  border-color: var(--border);
  background: rgba(0,180,255,0.05);
}

/* Divider line */
.divider {
  width: 1px;
  height: 20px;
  background: var(--border);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-20px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media(max-width:600px){
  .steps { flex-direction: column; align-items: stretch; }
  .btn-whop { width: 100%; justify-content: center; }
}
</style>
</head>
<body>

<div class="bg"></div>
<div class="grid"></div>

<!-- Floating particles -->
<div class="particles" id="particles"></div>

<div class="container">

  <!-- Logo -->
  <div class="logo">
    <img src="data:image/png;base64," alt="OptionLensa">
    <span class="logo-text">OptionLensa</span>
  </div>

  <!-- Check -->
  <div class="check-wrap">
    <div class="check-circle">✓</div>
  </div>

  <!-- Text -->
  <p class="thank-label">Subscription confirmed</p>
  <h1 class="thank-title">Welcome to<br><span>OptionLensa!</span></h1>
  <p class="thank-sub">You're all set. Follow the steps below to activate your tool and start trading smarter with IBKR.</p>

  <!-- Steps -->
  <div class="steps">
    <div class="step">
      <div class="step-num">1</div>
      <span>Get your license key from Whop</span>
    </div>
    <div class="step">
      <div class="step-num">2</div>
      <span>Download & run OptionLensa.exe</span>
    </div>
    <div class="step">
      <div class="step-num">3</div>
      <span>Enter key → start trading</span>
    </div>
  </div>

  <!-- Buttons -->
  <div class="btn-group">
    <a href="https://whop.com/option-lensa" target="_blank" class="btn-whop">
      🔑 Go to Whop — Get Your License Key
    </a>
    <div class="divider"></div>
    <a href="https://optionlensa.com" class="btn-home">
      ← Back to OptionLensa Home
    </a>
  </div>

</div>

<script>
// Generate floating particles
const container = document.getElementById('particles');
const colors = ['#00e676','#00b4ff','#7c3aed','#00e5ff'];
for(let i = 0; i < 30; i++){
  const p = document.createElement('div');
  p.className = 'particle';
  p.style.left = Math.random()*100 + 'vw';
  p.style.bottom = '-10px';
  p.style.background = colors[Math.floor(Math.random()*colors.length)];
  p.style.width = p.style.height = (Math.random()*4+2) + 'px';
  p.style.animationDuration = (Math.random()*4+4) + 's';
  p.style.animationDelay = (Math.random()*6) + 's';
  p.style.opacity = Math.random()*0.6+0.2;
  container.appendChild(p);
}
</script>
</body>
</html>
